{
  "name": "@robrain/eve",
  "version": "0.1.0",
  "type": "module",
  "description": "RoBrain memory provider for eve agents — team decision memory, including rejected alternatives, shared with your coding agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelinamart/robrain.git",
    "directory": "packages/eve"
  },
  "homepage": "https://github.com/adelinamart/robrain/tree/main/packages/eve#readme",
  "bugs": {
    "url": "https://github.com/adelinamart/robrain/issues"
  },
  "keywords": [
    "eve",
    "eve-memory",
    "memory-provider",
    "agent-memory",
    "decisions",
    "rejected-alternatives",
    "robrain"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "rm -rf dist && tsc -p tsconfig.publish.json",
    "prepack": "rm -rf dist && tsc -p tsconfig.publish.json",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun test src"
  },
  "peerDependencies": {
    "eve": ">=0.82.0 <1",
    "zod": ">=3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eve": "0.82.0",
    "typescript": "^5.4.0",
    "zod": "^4.0.0"
  }
}
